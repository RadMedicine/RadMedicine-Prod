# =================================================================
# RadMedicine — local dev / CI env template
# Copy to .env.local and fill in. .env.local is gitignored.
# =================================================================

# Supabase Postgres — TWO URLs, both from:
#   Supabase → Project Settings → Database → Connection string
# Var names match Supabase's own labels so pasting is unambiguous.
#
# DATABASE_URL   — POOLER url (port 6543, pgbouncer transaction mode).
#                  Used by the running app at request time.
# DIRECT_URL     — DIRECT url (port 5432).
#                  Used by `npm run db:migrate` because pgbouncer
#                  transaction mode doesn't support CREATE SCHEMA,
#                  advisory locks, and a few other session-level DDL
#                  primitives Drizzle's migrator relies on.
#
# Seed can run against either; it defaults to DATABASE_URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# NextAuth (magic-link over Postmark).
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Email (Postmark). Code is stubbed if these are missing — no
# dispatch, just a console log + audit row.
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=hello@radmedicine.io
POSTMARK_MESSAGE_STREAM=outbound

# Canonical site URL for SEO (sitemap absolute URLs, OG image
# resolution, robots.txt sitemap pointer). Include scheme, no trailing
# slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Admin allowlist — comma-separated emails. Anyone in this list who
# completes a magic-link sign-in can reach /admin.
ADMIN_EMAILS=jon@radmedicine.io

# Plausible analytics. Set DOMAIN to the Plausible-tracked domain
# (e.g. radmedicine.io). Leave blank to disable analytics entirely —
# nothing loads until both vars are set. SRC is optional (self-host).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
